# Copy this file to .env and fill in your own values. Never commit .env.

# SerpAPI key (https://serpapi.com/manage-api-key). Free plan: 250 searches/month.
SERPAPI_API_KEY=

# Google Places API (New) key (Google Cloud console -> enable "Places API (New)").
GOOGLE_PLACES_API_KEY=

# Contact email sent in the User-Agent to free OpenStreetMap services (their usage policy asks for it).
CONTACT_EMAIL=

# Optional rotating proxies (residential recommended for Google Maps). Comma separated:
#   http://user:pass@host:port, host:port, host:port:user:pass, socks5://host:port
PROXIES=
# ...or one proxy per line in a file:
PROXY_FILE=

# Optional: secret header for your self-hosted Reacher email verifier
REACHER_SECRET=

# Google PageSpeed Insights key (free: Google Cloud console -> enable "PageSpeed Insights API").
PAGESPEED_API_KEY=

# AI provider keys (only the one you choose in config.toml [llm] is needed)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Local Ollama server, default http://localhost:11434
OLLAMA_URL=

# Optional: domain authority for the Local SEO score (free key at openpagerank.com)
OPENPAGERANK_API_KEY=

# Optional: get "new advertiser" alerts in n8n / Make / Zapier / Slack (webhook URL)
ALERT_WEBHOOK_URL=

# Preview page hosting (Phase 8) - only the one you use
NETLIFY_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Outreach (Phase 9). Drafts need none of these.
# Mailbox login for IMAP "save to Drafts", reply checking and (opt-in) SMTP sending.
# Use a mailbox on a SEPARATE outreach domain and an app password, never your main password.
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASSWORD=
# Optional webhook (n8n / Make / Zapier) that receives drafts as JSON
OUTREACH_WEBHOOK_URL=

# Optional. Default is SQLite at data/leadengine.db. Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/leadengine
DATABASE_URL=

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
