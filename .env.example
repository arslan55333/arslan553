# Copy this file to .env and fill in your own values. Never commit .env.

# SerpAPI key (https://serpapi.com/manage-api-key). Free plan: 250 searches/month.
SERPAPI_API_KEY=

# Google Places API (New) key (Google Cloud console -> enable "Places API (New)").
GOOGLE_PLACES_API_KEY=

# Contact email sent in the User-Agent to free OpenStreetMap services (their usage policy asks for it).
CONTACT_EMAIL=

# Optional rotating proxies (residential recommended for Google Maps). Comma separated:
#   http://user:pass@host:port, host:port, host:port:user:pass, socks5://host:port
PROXIES=
# ...or one proxy per line in a file:
PROXY_FILE=

# Optional: secret header for your self-hosted Reacher email verifier
REACHER_SECRET=

# Optional. Default is SQLite at data/leadengine.db. Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/leadengine
DATABASE_URL=

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
